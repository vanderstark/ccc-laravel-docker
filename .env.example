# Environment example — Crisis Command Center (Laravel)
APP_NAME="CCC - Crisis Command Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (MySQL di Docker Compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ccc_database
DB_USERNAME=ccc_user
DB_PASSWORD=secret

# --- Session/Cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (opsional) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=ccc@localhost
MAIL_FROM_NAME="CCC"

# --- Bersihkan config cache saat deploy ---
APP_TIMEZONE=Asia/Jakarta